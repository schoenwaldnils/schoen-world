{
  "name": "schoen-world",
  "version": "2.0.0",
  "description": "Schoen.World",
  "scripts": {
    "dev": "next dev -p 3002 --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "pnpm lint:ts && pnpm lint:types",
    "lint:ts": "eslint . --ext .ts,.tsx",
    "lint:ts-fix": "eslint . --ext .ts,.tsx --fix",
    "lint:types": "tsc",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install",
    "test": "pnpm lint:ts && pnpm lint:types",
    "snyk-protect": "snyk-protect",
    "prepare": "pnpm snyk-protect",
    "knip": "knip"
  },
  "keywords": [],
  "repository": "github:schoenwaldnils/schoen-world",
  "author": {
    "name": "Nils Schönwald",
    "email": "nils@schoen.world"
  },
  "license": "ISC",
  "dependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@tailwindcss/postcss": "^4.3.2",
    "clsx": "^2.1.1",
    "cookies-next": "^6.1.1",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "next-mdx-remote-client": "^2.1.11",
    "next-view-transitions": "^0.3.5",
    "postcss-custom-media": "^12.0.1",
    "query-string": "^9.4.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-lowlight": "^3.1.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "rss": "^1.2.2",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.10",
    "@playwright/test": "^1.61.1",
    "@snyk/protect": "^1.1305.2",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/rss": "^0.0.32",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "knip": "^6.24.0",
    "postcss": "^8.5.16",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-arm64-musl": "^4.1.14",
    "@tailwindcss/oxide-linux-x64-musl": "^4.1.14",
    "lightningcss-linux-arm64-musl": "^1.30.2",
    "lightningcss-linux-x64-musl": "^1.30.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "NODE_ENV=production lint-staged && pnpm lint:types"
    }
  },
  "lint-staged": {
    "**/*.(ts|tsx|mdx)": [
